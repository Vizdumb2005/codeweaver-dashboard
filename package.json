{
  "name": "codeweaver-dashboard",
  "version": "1.0.0",
  "description": "CodeWeaver Dashboard - SPA built with Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:console && vite build && node scripts/upload-sourcemaps.cjs && node scripts/check-budgets.cjs",
    "build:staging": "vite build --mode staging && node scripts/upload-sourcemaps.cjs && node scripts/check-budgets.cjs",
    "analyze": "vite-bundle-visualizer",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:production": "eslint -c .eslintrc.production.json src --ext .ts,.tsx,.js,.jsx",
    "lint:production:fix": "eslint -c .eslintrc.production.json src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:all": "npm run lint && npm run lint:production",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\"",
    "check:console": "node scripts/check-console.cjs",
    "check:console:fix": "node scripts/check-console.cjs --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "cd .. && node codeweaver-dashboard/node_modules/husky/bin.js codeweaver-dashboard/.husky"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "glob": "^10.3.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "prettier": "^3.2.5",
    "sass": "^1.100.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
