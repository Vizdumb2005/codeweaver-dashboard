// --- SHURIKEN DRAWING UTILITY FOR CANVAS ---
function drawShuriken(ctx, cx, cy, spikes, outerRadius, innerRadius, fillStyle, strokeStyle, rotateRad = 0) {
  let rot = (Math.PI / 2 * 3) + rotateRad;
  let x = cx;
  let y = cy;
  let step = Math.PI / spikes;

  ctx.beginPath();
  ctx.moveTo(cx, cy - outerRadius);
  
  for (let i = 0; i < spikes; i++) {
    x = cx + Math.cos(rot) * outerRadius;
    y = cy + Math.sin(rot) * outerRadius;
    ctx.lineTo(x, y);
    rot += step;

    x = cx + Math.cos(rot) * innerRadius;
    y = cy + Math.sin(rot) * innerRadius;
    ctx.lineTo(x, y);
    rot += step;
  }
  ctx.lineTo(cx, cy - outerRadius);
  ctx.closePath();
  
  if (fillStyle) {
    ctx.fillStyle = fillStyle;
    ctx.fill();
  }
  if (strokeStyle) {
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = 1.8;
    ctx.stroke();
  }
}

// --- SMOKE PUFF VISUAL EFFECT TRIGGER ( billowing smoke overlay ) ---
function triggerSmokePuff(cardId) {
  const cardElement = document.querySelector(`.task-card[data-id="${cardId}"]`);
  if (!cardElement) return;

  const container = document.createElement("div");
  container.className = "smoke-puff-container";

  // Create 6 puff particles
  for (let i = 0; i < 6; i++) {
    const particle = document.createElement("div");
    particle.className = "smoke-particle";
    
    // Randomize size, position, and delay
    const size = Math.random() * 45 + 35; // 35px to 80px
    particle.style.width = `${size}px`;
    particle.style.height = `${size}px`;
    particle.style.left = `${Math.random() * 60 + 20}%`;
    particle.style.top = `${Math.random() * 60 + 20}%`;
    particle.style.animationDelay = `${Math.random() * 0.12}s`;
    
    container.appendChild(particle);
  }

  cardElement.appendChild(container);
  
  // Auto remove after animation completes
  setTimeout(() => {
    container.remove();
  }, 850);
}

// --- GRAPH VISUALIZATION (CANVAS) ---
class SwarmGraph {
  constructor(canvasId) {
    this.canvas = document.getElementById(canvasId);
    this.ctx = this.canvas.getContext("2d");
    this.nodes = [];
    this.links = [];
    this.animationFrameId = null;

    // Resize canvas
    this.resize();
    window.addEventListener("resize", () => this.resize());

    // Click handler
    this.canvas.addEventListener("click", (e) => this.handleCanvasClick(e));
  }

  resize() {
    const rect = this.canvas.parentElement.getBoundingClientRect();
    this.canvas.width = rect.width;
    this.canvas.height = rect.height;
    this.initGraph();
  }

  initGraph() {
    const w = this.canvas.width;
    const h = this.canvas.height;
    const cx = w / 2;
    const cy = h / 2;

    // Setup Agent Nodes coordinates
    const agentPositions = {
      orchestrator: { x: cx, y: cy - 70 },
      pm: { x: cx - 180, y: cy - 140 },
      architect: { x: cx - 180, y: cy - 30 },
      coder1: { x: cx - 60, y: cy + 90 },
      coder2: { x: cx + 60, y: cy + 90 },
      tester: { x: cx + 180, y: cy - 30 },
      security: { x: cx + 180, y: cy - 140 },
      devops: { x: cx - 220, y: cy + 80 },
      documentation: { x: cx + 220, y: cy + 80 },
      performance: { x: cx, y: cy - 200 },
      hunter: { x: cx - 80, y: cy - 200 },
      updater: { x: cx + 80, y: cy - 200 }
    };

    this.nodes = Object.keys(state.agents).map(key => {
      const agent = state.agents[key];
      const pos = agentPositions[key] || { x: cx, y: cy };
      return {
        id: agent.id,
        name: agent.name,
        icon: agent.icon,
        role: agent.role,
        x: pos.x,
        y: pos.y,
        radius: 24,
        pulseVal: 0,
        rotation: Math.random() * Math.PI * 2 // Randomized initial alignment
      };
    });

    // Setup Links
    this.links = [
      { source: "orchestrator", target: "pm", pulseOffset: 0 },
      { source: "orchestrator", target: "architect", pulseOffset: 0.2 },
      { source: "orchestrator", target: "coder1", pulseOffset: 0.4 },
      { source: "orchestrator", target: "coder2", pulseOffset: 0.6 },
      { source: "orchestrator", target: "tester", pulseOffset: 0.8 },
      { source: "orchestrator", target: "security", pulseOffset: 0.1 },
      { source: "orchestrator", target: "devops", pulseOffset: 0.3 },
      { source: "orchestrator", target: "documentation", pulseOffset: 0.5 },
      { source: "orchestrator", target: "performance", pulseOffset: 0.7 },
      { source: "orchestrator", target: "hunter", pulseOffset: 0.15 },
      { source: "orchestrator", target: "updater", pulseOffset: 0.35 },
      { source: "coder1", target: "tester", pulseOffset: 0.2 },
      { source: "coder2", target: "tester", pulseOffset: 0.4 },
      { source: "coder1", target: "security", pulseOffset: 0.6 }
    ];
  }

  draw() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

    // Draw grid background
    this.ctx.strokeStyle = "rgba(255, 255, 255, 0.012)";
    this.ctx.lineWidth = 1;
    const gridSize = 40;
    for (let x = 0; x < this.canvas.width; x += gridSize) {
      this.ctx.beginPath();
      this.ctx.moveTo(x, 0);
      this.ctx.lineTo(x, this.canvas.height);
      this.ctx.stroke();
    }
    for (let y = 0; y < this.canvas.height; y += gridSize) {
      this.ctx.beginPath();
      this.ctx.moveTo(0, y);
      this.ctx.lineTo(this.canvas.width, y);
      this.ctx.stroke();
    }

    // Draw connections (glowing silk threads)
    this.links.forEach(link => {
      const sourceNode = this.nodes.find(n => n.id === link.source);
      const targetNode = this.nodes.find(n => n.id === link.target);
      if (!sourceNode || !targetNode) return;

      const activeLink = state.systemStatus === "active" && 
        (state.agents[sourceNode.id].status !== "idle" || state.agents[targetNode.id].status !== "idle");

      // Draw connection line
      this.ctx.beginPath();
      this.ctx.moveTo(sourceNode.x, sourceNode.y);
      this.ctx.lineTo(targetNode.x, targetNode.y);
      this.ctx.strokeStyle = activeLink 
        ? "rgba(255, 115, 0, 0.45)" 
        : "rgba(255, 255, 255, 0.03)";
      this.ctx.lineWidth = activeLink ? 2 : 1.5;
      
      if (activeLink) {
        this.ctx.shadowBlur = 8;
        this.ctx.shadowColor = "#ff7300";
      }
      this.ctx.stroke();
      this.ctx.shadowBlur = 0; // reset blur

      // Draw throwing star particle
      if (activeLink) {
        link.pulseOffset += 0.004; // smooth particle movement
        if (link.pulseOffset > 1) link.pulseOffset = 0;
        
        const px = sourceNode.x + (targetNode.x - sourceNode.x) * link.pulseOffset;
        const py = sourceNode.y + (targetNode.y - sourceNode.y) * link.pulseOffset;

        this.ctx.save();
        this.ctx.translate(px, py);
        this.ctx.rotate(link.pulseOffset * Math.PI * 10);
        this.ctx.shadowBlur = 10;
        this.ctx.shadowColor = "#ff7300";
        drawShuriken(this.ctx, 0, 0, 4, 6, 2.5, "#ff7300", null);
        this.ctx.restore();
      }
    });

    // Draw nodes
    this.nodes.forEach(node => {
      const agent = state.agents[node.id];
      const isSelected = state.selectedAgentId === node.id;
      
      // Status-specific spin rates
      let rotSpeed = 0.002; // slow drift for idle
      if (agent.status === "coding") {
        rotSpeed = 0.022; // active coding spin
      } else if (agent.status === "thinking") {
        rotSpeed = 0.007; // meditative thinking spin
      } else if (agent.status === "error") {
        rotSpeed = -0.012; // reverse jammed spin
      }

      if (state.systemStatus === "active") {
        node.rotation = (node.rotation || 0) + rotSpeed;
      }
      
      // Node Pulse animation
      node.pulseVal += 0.025; 
      const pulseSize = node.radius + Math.sin(node.pulseVal) * 2.5;

      // Draw active pulsing ring
      if (agent.status === "thinking" || agent.status === "coding") {
        this.ctx.beginPath();
        this.ctx.arc(node.x, node.y, pulseSize + 4, 0, Math.PI * 2);
        this.ctx.strokeStyle = agent.status === "thinking" ? "rgba(255, 179, 0, 0.25)" : "rgba(255, 115, 0, 0.25)";
        this.ctx.lineWidth = 1;
        this.ctx.stroke();
      }

      // Draw Selected Glowing Outer Ring
      if (isSelected) {
        this.ctx.beginPath();
        this.ctx.arc(node.x, node.y, node.radius + 8, 0, Math.PI * 2);
        this.ctx.strokeStyle = "#ff7300";
        this.ctx.lineWidth = 2;
        this.ctx.stroke();
      }

      // Draw Shuriken Crest
      const isActive = agent.status !== "idle";
      const shurikenColor = isSelected ? "rgba(45, 25, 15, 0.9)" : "rgba(12, 10, 8, 0.85)";
      const strokeColor = isSelected ? "#ff7300" : isActive ? "rgba(255, 115, 0, 0.4)" : "rgba(255, 255, 255, 0.1)";
      
      this.ctx.save();
      this.ctx.translate(node.x, node.y);
      this.ctx.rotate(node.rotation || 0);
      drawShuriken(this.ctx, 0, 0, 4, node.radius + 2, node.radius - 12, shurikenColor, strokeColor);
      this.ctx.restore();

      // Draw Emoji
      this.ctx.font = "20px var(--font-sans)";
      this.ctx.textAlign = "center";
      this.ctx.textBaseline = "middle";
      this.ctx.fillStyle = "#fff";
      this.ctx.fillText(node.icon, node.x, node.y + 1);

      // Draw Status Dot indicator
      let statusColor = "#5e5248"; // idle
      if (agent.status === "thinking") statusColor = "#FFB300"; 
      if (agent.status === "coding") statusColor = "#ff7300"; 
      if (agent.status === "error") statusColor = "#ef4444";

      this.ctx.beginPath();
      this.ctx.arc(node.x + 15, node.y - 15, 5.5, 0, Math.PI * 2);
      this.ctx.fillStyle = statusColor;
      this.ctx.strokeStyle = "#080605";
      this.ctx.lineWidth = 1.5;
      this.ctx.fill();
      this.ctx.stroke();

      // Label Text
      this.ctx.font = "600 11px var(--font-sans)";
      this.ctx.fillStyle = isSelected ? "#ff9d4d" : "#94a3b8";
      this.ctx.fillText(node.name, node.x, node.y + node.radius + 16);

      // Subtitle status text
      this.ctx.font = "400 9px var(--font-mono)";
      this.ctx.fillStyle = agent.status !== "idle" ? "#5e5248" : "#322923";
      this.ctx.fillText(`[${agent.status.toUpperCase()}]`, node.x, node.y + node.radius + 26);
    });

    if (state.activeTab === "swarm-graph") {
      this.animationFrameId = requestAnimationFrame(() => this.draw());
    }
  }

  handleCanvasClick(e) {
    const rect = this.canvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;

    // Check hit nodes
    const hitNode = this.nodes.find(node => {
      const distance = Math.sqrt((clickX - node.x) ** 2 + (clickY - node.y) ** 2);
      return distance <= node.radius + 8;
    });

    if (hitNode) {
      selectAgent(hitNode.id);
    }
  }

  start() {
    if (!this.animationFrameId) {
      this.draw();
    }
  }

  stop() {
    if (this.animationFrameId) {
      cancelAnimationFrame(this.animationFrameId);
      this.animationFrameId = null;
    }
  }
}

let swarmGraph = null;

// --- DYNAMIC RENDERING UTILITIES ---

function selectAgent(agentId) {
  state.selectedAgentId = agentId;
  const agent = state.agents[agentId];
  
  // Show Agent Pane and Hide Task Pane
  document.getElementById("pane-agent-detail").classList.add("active");
  document.getElementById("pane-task-detail").classList.remove("active");

  // Update Detail UI
  document.getElementById("agent-detail-name").innerText = agent.name;
  
  let statusClass = "status-idle";
  let statusText = "Hidden";
  if (agent.status === "thinking") {
    statusClass = "status-thinking";
    statusText = "Meditating";
  } else if (agent.status === "coding") {
    statusClass = "status-coding";
    statusText = "Attacking";
  } else if (agent.status === "watching") {
    statusClass = "status-thinking";
    statusText = "Scouting";
  } else if (agent.status === "sleeping") {
    statusClass = "status-idle";
    statusText = "Hibernating";
  }
  
  const statusBadge = document.getElementById("agent-detail-status");
  statusBadge.innerText = statusText;
  statusBadge.className = `status-badge ${statusClass}`;

  const avatarRing = document.getElementById("agent-detail-avatar-ring");
  avatarRing.className = `avatar-ring ${agent.status !== "idle" && agent.status !== "sleeping" ? "active-pulse" : ""}`;
  document.getElementById("agent-detail-avatar-inner").innerText = agent.icon;

  document.getElementById("agent-detail-objective").innerText = agent.objective;
  
  // Route / Ram / Cost
  document.getElementById("agent-detail-route").innerText = agent.route;
  document.getElementById("agent-detail-ram").innerText = agent.ram;
  document.getElementById("agent-detail-cost").innerText = `$${agent.cost.toFixed(2)}`;

  // Skills
  const skillsContainer = document.getElementById("agent-detail-skills");
  skillsContainer.innerHTML = "";
  agent.skills.forEach(skill => {
    const span = document.createElement("span");
    span.className = "skill-tag";
    span.innerText = skill;
    skillsContainer.appendChild(span);
  });

  // Active Task Card
  const taskCard = document.getElementById("agent-detail-task-card");
  if (agent.currentTaskId) {
    const task = state.tasks.find(t => t.id === agent.currentTaskId);
    taskCard.style.display = "flex";
    document.getElementById("agent-detail-task-title").innerText = task.title;
    document.getElementById("agent-detail-task-meta").innerText = `Priority ${task.priority} • ID: #${task.id}`;
  } else {
    taskCard.style.display = "none";
  }
}

function selectTask(taskId) {
  state.selectedTaskId = taskId;
  const task = state.tasks.find(t => t.id === taskId);
  
  // Show Task Pane and Hide Agent Pane
  document.getElementById("pane-agent-detail").classList.remove("active");
  document.getElementById("pane-task-detail").classList.add("active");

  // Update Detail UI
  document.getElementById("task-detail-title").innerText = task.title;
  document.getElementById("task-detail-id").innerText = `ID: #${task.id}`;
  document.getElementById("task-detail-desc").innerText = task.desc;
  
  const colBadge = document.getElementById("task-detail-col-badge");
  colBadge.innerText = task.status.replace("_", " ").toUpperCase();
  let badgeClass = "badge-outline";
  if (task.status === "in_progress") badgeClass = "badge-purple";
  if (task.status === "review") badgeClass = "badge-warning";
  if (task.status === "completed") badgeClass = "badge-success";
  colBadge.className = `badge ${badgeClass}`;

  document.getElementById("task-detail-assignee").innerText = state.agents[task.assignee]?.name || "Unassigned";
  document.getElementById("task-detail-priority").innerText = `${task.priority} / 5`;
  
  const complexityBadge = document.getElementById("task-detail-complexity");
  complexityBadge.innerHTML = `<span class="badge ${task.complexity === "complex" ? "badge-purple" : task.complexity === "medium" ? "badge-warning" : "badge-outline"}">${task.complexity.toUpperCase()}</span>`;

  document.getElementById("task-detail-duration").innerText = task.duration;
  document.getElementById("task-detail-attempts").innerText = task.attempts;

  // Dependencies
  const depsContainer = document.getElementById("task-detail-deps");
  depsContainer.innerHTML = "";
  if (task.deps.length > 0) {
    task.deps.forEach(depId => {
      const depTask = state.tasks.find(t => t.id === depId);
      const span = document.createElement("span");
      span.className = "badge badge-outline";
      span.innerText = depTask ? depTask.title : depId;
      depsContainer.appendChild(span);
    });
  } else {
    depsContainer.innerHTML = `<span class="text-muted text-xs">No dependencies</span>`;
  }

  // Logs output
  const outputContainer = document.getElementById("task-detail-output");
  if (task.output) {
    outputContainer.innerText = task.output;
    outputContainer.style.color = "#FFB300"; // Amber gold
  } else {
    if (task.status === "in_progress") {
      outputContainer.innerText = `[Attacking Scroll] Code compilation ongoing. Progress: ${task.progress}%...\n> Scanning package buffers\n> Injecting hooks`;
      outputContainer.style.color = "#ff7300"; // Samurai Orange
    } else {
      outputContainer.innerText = "Task is queued in backlog. Awaiting active workspace scheduling.";
      outputContainer.style.color = "#5e5248";
    }
  }
}

// Render Kanban columns
function renderKanban(filter = "all") {
  const lists = {
    backlog: document.getElementById("list-backlog"),
    in_progress: document.getElementById("list-in-progress"),
    review: document.getElementById("list-review"),
    completed: document.getElementById("list-completed")
  };

  let counts = { backlog: 0, in_progress: 0, review: 0, completed: 0 };
  const activeTaskIds = [];

  state.tasks.forEach(task => {
    // Filter
    let matchesFilter = true;
    if (filter !== "all") {
      matchesFilter = task.tags.some(tag => tag.toLowerCase().includes(filter));
    }

    if (matchesFilter) {
      counts[task.status]++;
      activeTaskIds.push(task.id);
    }

    // Find if card already exists
    let card = document.querySelector(`.task-card[data-id="${task.id}"]`);

    if (!matchesFilter) {
      if (card) card.remove();
      return;
    }

    const targetList = lists[task.status];
    if (!targetList) return;

    if (!card) {
      // Create new card
      card = document.createElement("div");
      card.className = `task-card`;
      card.setAttribute("draggable", "true");
      card.dataset.id = task.id;

      // Click handler
      card.addEventListener("click", () => {
        selectTask(task.id);
        document.querySelectorAll(".task-card").forEach(c => c.classList.remove("active-border-glow"));
        card.classList.add("active-border-glow");
      });

      // Drag-drop events
      card.addEventListener("dragstart", (e) => {
        e.dataTransfer.setData("text/plain", task.id);
        card.style.opacity = "0.5";
      });
      card.addEventListener("dragend", (e) => {
        card.style.opacity = "1";
      });

      targetList.appendChild(card);
      card.style.animation = "card-appear 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards";
    } else {
      // Move card if status changed
      if (card.parentElement !== targetList) {
        triggerSmokePuff(task.id);
        targetList.appendChild(card);
        
        card.style.animation = "none";
        card.offsetHeight; // force reflow
        card.style.animation = "card-appear 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards";
      }
    }

    // Update border glow
    if (task.id === state.selectedTaskId) {
      card.classList.add("active-border-glow");
    } else {
      card.classList.remove("active-border-glow");
    }

    // Rebuild internal elements dynamically
    card.innerHTML = "";

    // Head
    const head = document.createElement("div");
    head.className = "card-head";

    const title = document.createElement("span");
    title.className = "task-title";
    title.innerText = task.title;
    head.appendChild(title);

    // Priority mark (Japanese culture shuriken SVG)
    const priorityIcon = document.createElement("span");
    priorityIcon.className = `priority-icon p${task.priority}`;
    priorityIcon.innerHTML = `
      <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;vertical-align:middle;filter:drop-shadow(0 0 2px currentColor);">
        <path d="M12 2 L14 9 L21 7 L16 12 L21 17 L14 15 L12 22 L10 15 L3 17 L8 12 L3 7 L10 9 Z" fill="currentColor"/>
      </svg>
    `;
    head.appendChild(priorityIcon);
    card.appendChild(head);

    // Description
    const desc = document.createElement("p");
    desc.className = "card-desc";
    desc.innerText = task.desc.length > 75 ? task.desc.substring(0, 75) + "..." : task.desc;
    card.appendChild(desc);

    // Progress bar for active task
    if (task.status === "in_progress") {
      const progressContainer = document.createElement("div");
      progressContainer.className = "card-progress-container";
      const progressFill = document.createElement("div");
      progressFill.className = "card-progress-fill";
      progressFill.style.width = `${task.progress || 0}%`;
      progressContainer.appendChild(progressFill);
      card.appendChild(progressContainer);
    }

    // Foot
    const foot = document.createElement("div");
    foot.className = "card-foot";

    // Tags
    const tags = document.createElement("div");
    tags.className = "card-tags";
    task.tags.forEach(t => {
      const span = document.createElement("span");
      span.className = "tag";
      span.innerText = t;
      tags.appendChild(span);
    });
    foot.appendChild(tags);

    // Assignee
    const assignee = document.createElement("div");
    assignee.className = "card-assignee";
    const agent = state.agents[task.assignee];
    if (agent) {
      const avatar = document.createElement("span");
      avatar.className = "avatar-icon";
      avatar.innerText = agent.icon;
      assignee.appendChild(avatar);

      const name = document.createElement("span");
      name.innerText = agent.name.split(" ")[0];
      assignee.appendChild(name);
    }
    foot.appendChild(assignee);
    card.appendChild(foot);
  });

  // Remove elements that don't match the active selection/filter
  document.querySelectorAll(".task-card").forEach(card => {
    if (!activeTaskIds.includes(card.dataset.id)) {
      card.remove();
    }
  });

  // Set counts
  document.getElementById("count-backlog").innerText = counts.backlog;
  document.getElementById("count-in-progress").innerText = counts.in_progress;
  document.getElementById("count-review").innerText = counts.review;
  document.getElementById("count-completed").innerText = counts.completed;

  // Sidebar counter
  document.getElementById("in-progress-count").innerText = counts.in_progress + counts.review;
}

// Render Decision list
function renderDecisions() {
  const container = document.getElementById("decisions-container");
  container.innerHTML = "";

  let pendingCount = 0;

  state.decisions.forEach(decision => {
    if (decision.status === "proposed") pendingCount++;

    const card = document.createElement("div");
    card.className = `decision-card ${decision.status === "proposed" ? "pending" : ""}`;

    // Header
    const header = document.createElement("div");
    header.className = "decision-header";

    const titleGroup = document.createElement("div");
    titleGroup.className = "decision-title-group";
    
    const title = document.createElement("h3");
    title.innerText = decision.title;
    titleGroup.appendChild(title);

    const meta = document.createElement("div");
    meta.className = "decision-meta";
    meta.innerText = `Proposed by: ${state.agents[decision.decidedBy]?.name || decision.decidedBy} • Status: ${decision.status.toUpperCase()}`;
    titleGroup.appendChild(meta);

    header.appendChild(titleGroup);

    // Confidence
    const confidence = document.createElement("div");
    confidence.className = "decision-confidence";
    confidence.innerHTML = `
      <span class="confidence-val">${decision.confidence}%</span>
      <span class="confidence-label">Focus</span>
    `;
    header.appendChild(confidence);
    card.appendChild(header);

    // Description
    const desc = document.createElement("p");
    desc.className = "decision-desc";
    desc.innerText = decision.desc;
    card.appendChild(desc);

    // Alternatives Grid
    const optionsGrid = document.createElement("div");
    optionsGrid.className = "decision-options";

    decision.alternatives.forEach((alt, idx) => {
      const isSelected = idx === decision.selectedAlternative;
      const optBox = document.createElement("div");
      optBox.className = `option-box ${isSelected ? "selected" : ""}`;
      
      const checkIconSvg = isSelected 
        ? `<svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:14px;height:14px;vertical-align:middle;color:var(--accent-purple);margin-right:6px;">
             <path d="M12 3 C 6 3, 3 8, 3 13 C 3 18, 8 21, 13 21 C 18 21, 21 17, 21 12 C 21 8, 18 4.5, 14.5 4" fill="none"/>
             <path d="M9 12 l2 2 l4 -4" stroke="currentColor" stroke-linecap="round"/>
           </svg>`
        : `<svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;vertical-align:middle;color:var(--text-muted);margin-right:6px;">
             <path d="M12 3 C 6 3, 3 8, 3 13 C 3 18, 8 21, 13 21 C 18 21, 21 17, 21 12 C 21 8, 18 4.5, 14.5 4"/>
           </svg>`;

      optBox.innerHTML = `
        <h4>
          ${checkIconSvg}
          <span>Option ${idx + 1}: ${alt.title}</span>
        </h4>
        <div class="pros-cons">
          <p style="color:var(--accent-cyan);margin-top:4px;"><strong>Pros:</strong> ${alt.pros}</p>
          <p style="color:var(--accent-error);margin-top:2px;"><strong>Cons:</strong> ${alt.cons}</p>
        </div>
      `;
      optionsGrid.appendChild(optBox);
    });
    card.appendChild(optionsGrid);

    // Rationale
    const rationale = document.createElement("div");
    rationale.className = "decision-rationale";
    rationale.innerHTML = `<strong>Grandmaster Rationale:</strong> ${decision.rationale}`;
    card.appendChild(rationale);

    // Actions
    if (decision.status === "proposed") {
      const actions = document.createElement("div");
      actions.className = "decision-actions";

      const rejectBtn = document.createElement("button");
      rejectBtn.className = "btn btn-outline btn-sm";
      rejectBtn.innerText = "Override Decrees";
      rejectBtn.addEventListener("click", () => handleDecisionResolve(decision.id, false));
      actions.appendChild(rejectBtn);

      const approveBtn = document.createElement("button");
      approveBtn.className = "btn btn-primary btn-sm";
      approveBtn.innerText = "Enforce Decrees";
      approveBtn.addEventListener("click", () => handleDecisionResolve(decision.id, true));
      actions.appendChild(approveBtn);

      card.appendChild(actions);
    } else {
      const resolvedBanner = document.createElement("div");
      resolvedBanner.className = "decision-actions";
      resolvedBanner.innerHTML = `<span style="font-size:0.75rem;color:var(--accent-cyan);font-weight:600;">
        <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;vertical-align:middle;margin-right:4px;color:var(--accent-cyan);">
          <rect x="3" y="3" width="18" height="18" rx="2" fill="rgba(255,179,0,0.1)"/>
          <path d="M8 12 l3 3 l5 -5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        Decree Enforced (Auto-Locked)
      </span>`;
      card.appendChild(resolvedBanner);
    }

    container.appendChild(card);
  });

  document.getElementById("pending-decisions-count").innerText = pendingCount;
  document.getElementById("pending-decisions-count").style.display = pendingCount > 0 ? "inline-block" : "none";
}

// Approve/Reject Decision actions
function handleDecisionResolve(decisionId, approved) {
  const decision = state.decisions.find(d => d.id === decisionId);
  if (!decision) return;

  decision.status = approved ? "decided" : "overridden";
  
  // Log message
  const timestamp = new Date().toTimeString().split(" ")[0];
  const msgType = approved ? "success" : "error";
  const actionText = approved ? "approved decree" : "overrode decree";
  
  consoleLogs.push({
    time: timestamp,
    agent: "orchestrator",
    type: msgType,
    msg: `User ${actionText}: ${decision.title}. Option Enforced: ${decision.alternatives[decision.selectedAlternative].title}.`
  });

  // If approved SMTP decision, unlock backlog tasks
  if (decisionId === "decision-01") {
    // Modify Coder tasks
    const task = state.tasks.find(t => t.id === "task-04");
    if (task) {
      task.progress = 100;
      task.status = "completed";
      task.output = "[SMTP Module Configured]\nService: Nodemailer\nTransport: SMTP local proxy relay\nPort: 1025\nEncryption: TLS default SSL handshake pass.";
      
      // Trigger Smoke Puff visual effect on completed card!
      setTimeout(() => triggerSmokePuff("task-04"), 100);
    }

    // Move next task from Backlog to In-Progress
    const devopsTask = state.tasks.find(t => t.id === "task-06");
    if (devopsTask) {
      devopsTask.status = "in_progress";
      devopsTask.duration = "Active: 2 min elapsed";
      devopsTask.progress = 10;
      state.agents.devops.status = "coding";
      state.agents.devops.currentTaskId = "task-06";
    }

    // Free coder1 to backlog tasks
    state.agents.coder1.status = "idle";
    state.agents.coder1.currentTaskId = null;

    consoleLogs.push({
      time: timestamp,
      agent: "system",
      type: "info",
      msg: "SMTP Scroll task closed. Dispatched Scroll #06 (Setup Docker Compose) to Chunin DevOps."
    });
  }

  renderDecisions();
  renderKanban();
  renderLogs();
}

// Render System Logs in Console
function renderLogs() {
  const container = document.getElementById("console-lines-container");
  container.innerHTML = "";

  consoleLogs.forEach(log => {
    // Text search filter
    if (state.logSearchQuery) {
      const q = state.logSearchQuery.toLowerCase();
      const match = log.msg.toLowerCase().includes(q) || log.agent.toLowerCase().includes(q);
      if (!match) return;
    }

    // Agent dropdown filter
    if (state.logFilterAgent !== "all") {
      if (state.logFilterAgent === "coder") {
        if (log.agent !== "coder" && log.agent !== "coder1" && log.agent !== "coder2") return;
      } else {
        if (log.agent !== state.logFilterAgent) return;
      }
    }

    const div = document.createElement("div");
    div.className = `console-line ${log.type === "error" ? "error" : log.type === "success" ? "success" : ""}`;

    const timeSpan = document.createElement("span");
    timeSpan.className = "timestamp";
    timeSpan.innerText = `[${log.time}]`;
    div.appendChild(timeSpan);

    const agentSpan = document.createElement("span");
    agentSpan.className = `agent ${log.agent.replace("-", "").toLowerCase()}`;
    agentSpan.innerText = `${log.agent.toUpperCase()}:`;
    div.appendChild(agentSpan);

    const msgSpan = document.createElement("span");
    msgSpan.className = "message";
    msgSpan.innerText = log.msg;
    div.appendChild(msgSpan);

    container.appendChild(div);
  });

  // Auto scroll to bottom
  container.parentElement.scrollTop = container.parentElement.scrollHeight;
}

// --- DRAG AND DROP HANDLERS ---
function initDragAndDrop() {
  const cols = document.querySelectorAll(".kanban-col");
  
  cols.forEach(col => {
    col.addEventListener("dragover", (e) => {
      e.preventDefault();
      col.style.backgroundColor = "rgba(255, 115, 0, 0.04)";
    });

    col.addEventListener("dragleave", (e) => {
      col.style.backgroundColor = "rgba(8, 6, 5, 0.45)";
    });

    col.addEventListener("drop", (e) => {
      e.preventDefault();
      col.style.backgroundColor = "rgba(8, 6, 5, 0.45)";
      
      const taskId = e.dataTransfer.getData("text/plain");
      const targetColId = col.id.replace("col-", "").replace("-", "_"); // backlog, in_progress, review, completed
      
      const task = state.tasks.find(t => t.id === taskId);
      if (task && task.status !== targetColId) {
        // Log transition
        const timestamp = new Date().toTimeString().split(" ")[0];
        consoleLogs.push({
          time: timestamp,
          agent: "system",
          type: "info",
          msg: `Scroll #${task.id} (${task.title}) drag-moved from [${task.status.toUpperCase()}] to [${targetColId.toUpperCase()}] by User.`
        });
        
        // Remove task assignment from agents if completed/backlog
        if (targetColId === "completed" || targetColId === "backlog") {
          const agent = Object.values(state.agents).find(a => a.currentTaskId === task.id);
          if (agent) {
            agent.status = "idle";
            agent.currentTaskId = null;
          }
        }

        task.status = targetColId;
        renderKanban();
        renderLogs();
        
        // Trigger Smoke Puff visual effect on card!
        triggerSmokePuff(task.id);

        if (state.selectedTaskId === task.id) {
          selectTask(task.id);
        }
      }
    });
  });
}

// --- REAL-TIME SIMULATION LOOP ---
function runSimulationLoop() {
  setInterval(() => {
    if (state.systemStatus !== "active" || !state.streamLogs) return;

    const timestamp = new Date().toTimeString().split(" ")[0];

    // 1. Task Progress Increments
    const activeTask = state.tasks.find(t => t.status === "in_progress");
    if (activeTask) {
      if (activeTask.progress === undefined) activeTask.progress = 0;
      
      // Increment progress
      activeTask.progress += Math.floor(Math.random() * 8) + 4;
      if (activeTask.progress >= 100) {
        activeTask.progress = 100;
        activeTask.status = "review";
        activeTask.output = `[Jutsu Build Completed]\nCompiled target modules successfully.\nTesting review queued.`;
        
        // Trigger smoke puff
        triggerSmokePuff(activeTask.id);

        // Push logs
        consoleLogs.push({
          time: timestamp,
          agent: activeTask.assignee,
          type: "success",
          msg: `Completed coding Jutsu scroll: ${activeTask.title}. Submitting for verification testing.`
        });

        // Set assignee agent to idle
        const agent = state.agents[activeTask.assignee];
        if (agent) {
          agent.status = "idle";
          agent.currentTaskId = null;
        }

        // Trigger testing review
        const tester = state.agents.tester;
        tester.status = "coding"; // running tests
        
        const reviewTask = state.tasks.find(t => t.status === "review");
        if (reviewTask) {
          tester.currentTaskId = reviewTask.id;
        }

        consoleLogs.push({
          time: timestamp,
          agent: "tester",
          type: "info",
          msg: `Kunai Tester: Dispatched automated integration test suits on module changes.`
        });
      } else {
        // Periodic code edits logs
        if (Math.random() > 0.6) {
          const files = ["src/services/email.ts", "src/config/smtp.json", "src/controllers/notify.ts"];
          const file = files[Math.floor(Math.random() * files.length)];
          consoleLogs.push({
            time: timestamp,
            agent: activeTask.assignee,
            type: "info",
            msg: `${state.agents[activeTask.assignee].name} patching code block in ${file}...`
          });
        }
      }
    }

    // 2. Testing Review Progress
    const reviewTask = state.tasks.find(t => t.status === "review");
    if (reviewTask && state.agents.tester.status === "coding") {
      // Simulate tests passing
      if (Math.random() > 0.8) {
        reviewTask.status = "completed";
        reviewTask.output = "[Automated Integration Test Run]\nRunning: auth.test.ts\nSpecs: 12 tests passed, 0 failed\nCoverage: 87.5% lines covered.\nStealth check requested.";
        
        // Trigger smoke puff
        triggerSmokePuff(reviewTask.id);

        consoleLogs.push({
          time: timestamp,
          agent: "tester",
          type: "success",
          msg: `Integration tests passed successfully for: ${reviewTask.title}.`
        });

        const tester = state.agents.tester;
        tester.status = "idle";
        tester.currentTaskId = null;

        // Security check dispatch
        const secAgent = state.agents.security;
        secAgent.status = "thinking";
        consoleLogs.push({
          time: timestamp,
          agent: "security",
          type: "info",
          msg: "Stealth Auditor started dependency check & OWASP credential vulnerability scans..."
        });

        setTimeout(() => {
          const ts = new Date().toTimeString().split(" ")[0];
          secAgent.status = "idle";
          consoleLogs.push({
            time: ts,
            agent: "security",
            type: "success",
            msg: "Stealth Auditor checks completed. 0 vulnerabilities detected."
          });
          state.autoFixes += Math.random() > 0.8 ? 1 : 0;
          document.getElementById("metrics-auto-fixes").innerText = state.autoFixes;
        }, 3000);
      } else {
        // Test runner logging
        if (Math.random() > 0.7) {
          consoleLogs.push({
            time: timestamp,
            agent: "tester",
            type: "info",
            msg: `Kunai Tester: Executing integration spec [${Math.floor(Math.random() * 8) + 2} / 12]...`
          });
        }
      }
    }

    // 3. Backlog dispatch (if coder is idle and database decision resolved)
    if (!state.tasks.some(t => t.status === "in_progress") && state.decisions.find(d => d.id === "decision-01").status === "decided") {
      const backlogTask = state.tasks.find(t => t.status === "backlog");
      if (backlogTask) {
        const matchingAgentKey = Object.keys(state.agents).find(key => {
          const a = state.agents[key];
          return a.role === backlogTask.assignee && a.status === "idle";
        });

        if (matchingAgentKey) {
          const agent = state.agents[matchingAgentKey];
          backlogTask.status = "in_progress";
          backlogTask.progress = 0;
          backlogTask.duration = "Active: 1 min elapsed";
          agent.status = "coding";
          agent.currentTaskId = backlogTask.id;

          consoleLogs.push({
            time: timestamp,
            agent: "orchestrator",
            type: "info",
            msg: `Sensei dispatched Task #${backlogTask.id} (${backlogTask.title}) to ${agent.name}.`
          });
        }
      }
    }

    // 3.5. Autonomous Engine Simulation Logs
    if (state.agents.hunter.status === "watching" && Math.random() > 0.8) {
      const hunterLogs = [
        "Stealth Scout: Sentry streams clear. 0 anomalies detected in production loops.",
        "Stealth Scout: Production logs verified. API gateway latencies stable at 42ms.",
        "Stealth Scout: Scanned Datadog logs. Health checks passing on all clusters."
      ];
      consoleLogs.push({
        time: timestamp,
        agent: "hunter",
        type: "success",
        msg: hunterLogs[Math.floor(Math.random() * hunterLogs.length)]
      });
    }

    if (state.agents.updater.status !== "sleeping" && Math.random() > 0.85) {
      const updaterLogs = [
        "Debt Chunin: Running weekly cron check... 0 critical updates needed.",
        "Debt Chunin: Auditing security advisory scrolls. NPM registry package hashes verify OK.",
        "Debt Chunin: Code refactor sweep completed. Cleaned up 4 unused imports in src/controllers."
      ];
      consoleLogs.push({
        time: timestamp,
        agent: "updater",
        type: "info",
        msg: updaterLogs[Math.floor(Math.random() * updaterLogs.length)]
      });
    }

    const refactorToggleEl = document.getElementById("settings-refactor-toggle");
    if (refactorToggleEl && refactorToggleEl.checked && Math.random() > 0.9) {
      consoleLogs.push({
        time: timestamp,
        agent: "orchestrator",
        type: "success",
        msg: "Sensei: Swarm idle. Dispatched minor code quality refactoring sweep."
      });
    }

    // 4. Random Metrics Increments
    state.llmRequests += Math.floor(Math.random() * 2) + 1;
    state.accumulatedCost += parseFloat((Math.random() * 0.02 + 0.005).toFixed(4));
    
    // Limits budget logic
    if (state.accumulatedCost >= state.dailyLimit) {
      state.accumulatedCost = state.dailyLimit;
    }

    // Update global metrics UI
    document.getElementById("metrics-llm-requests").innerText = state.llmRequests;
    document.querySelector(".budget-spent").innerHTML = `$${state.accumulatedCost.toFixed(2)} <span class="budget-total">/ $${state.dailyLimit.toFixed(2)}</span>`;
    
    const fillPercent = Math.min((state.accumulatedCost / state.dailyLimit) * 100, 100);
    document.querySelector(".budget-bar-fill").style.width = `${fillPercent}%`;

    // 5. Update selected items panels if they are open
    if (state.selectedTaskId) selectTask(state.selectedTaskId);
    if (state.selectedAgentId) selectAgent(state.selectedAgentId);

    // Redraw lists & terminal
    renderKanban();
    renderLogs();

    // Keep Dojo Workbench interactive widgets updated
    if (typeof workbenchInitialized !== 'undefined' && workbenchInitialized) {
      renderChecklist();
      renderBrowserPreview();
      
      // Stream dynamic terminal activity
      if (state.activeTab === "dojo-workbench" && Math.random() > 0.5) {
        const projectKey = getActiveProjectKey();
        const timestamp = new Date().toTimeString().split(" ")[0];
        if (projectKey === "taskmaster") {
          const lines = [
            `[compiler] [${timestamp}] File watcher detected changes in src/services/email.ts. Recompiling...`,
            `[test-pass] [${timestamp}] ✓ email module re-compiled & mock SMTP relay tests succeeded.`
          ];
          appendTerminalLine("compiler", lines[0]);
          setTimeout(() => appendTerminalLine("test-pass", lines[1]), 600);
        } else {
          const lines = [
            `[compiler] [${timestamp}] File watcher triggered offline storage index validation in src/config/indexeddb.ts...`,
            `[test-pass] [${timestamp}] ✓ Geodesic GPS coordinate math assertions verified.`
          ];
          appendTerminalLine("compiler", lines[0]);
          setTimeout(() => appendTerminalLine("test-pass", lines[1]), 600);
        }
      }
    }
    
  }, 3000);
}

// --- PROJECT SETUP WIZARD PROCESS ---
function initWizard() {
  const modal = document.getElementById("project-wizard-modal");
  const openBtn = document.getElementById("new-project-btn");
  const closeBtn = document.getElementById("wizard-close-btn");
  
  openBtn.addEventListener("click", () => {
    modal.classList.add("active");
    resetWizard();
  });

  closeBtn.addEventListener("click", () => {
    modal.classList.remove("active");
  });

  // Step transitions
  document.getElementById("wizard-to-step-2-btn").addEventListener("click", () => {
    const promptText = document.getElementById("wizard-app-prompt").value.trim();
    if (!promptText) {
      alert("Please describe your mission concept to start sizing.");
      return;
    }
    
    document.getElementById("wizard-step-1").classList.remove("active");
    document.getElementById("wizard-step-2").classList.add("active");
  });

  document.getElementById("wizard-back-to-1-btn").addEventListener("click", () => {
    document.getElementById("wizard-step-2").classList.remove("active");
    document.getElementById("wizard-step-1").classList.add("active");
  });

  document.getElementById("wizard-to-step-3-btn").addEventListener("click", () => {
    const answersText = document.getElementById("wizard-pm-response").value.trim();
    if (!answersText) {
      alert("Please answer the PM's queries to complete task layout scoping.");
      return;
    }

    document.getElementById("wizard-step-2").classList.remove("active");
    document.getElementById("wizard-step-3").classList.add("active");

    runDecompositionAnimation();
  });
}

function resetWizard() {
  document.getElementById("wizard-step-1").classList.add("active");
  document.getElementById("wizard-step-2").classList.remove("active");
  document.getElementById("wizard-step-3").classList.remove("active");

  document.getElementById("wizard-app-prompt").value = "";
  document.getElementById("wizard-pm-response").value = "";

  document.getElementById("wizard-progress-bar-fill").style.width = "0%";
  document.getElementById("wizard-status-title").innerText = "Recon Shinobi drafting scrolls...";
  
  const steps = ["prd", "research", "architecture", "tasks"];
  steps.forEach(s => {
    const el = document.getElementById(`decomp-step-${s}`);
    el.className = "decomp-step pending";
  });

  document.getElementById("wizard-finished-footer").classList.add("hide");
}

function runDecompositionAnimation() {
  const steps = [
    { id: "prd", label: "Writing Mission Scroll (PRD)", progress: 25 },
    { id: "research", label: "Scouting tools & supplies", progress: 50 },
    { id: "architecture", label: "Sensei council debating strategy", progress: 75 },
    { id: "tasks", label: "Breaking down scrolls to Jutsu commands", progress: 100 }
  ];

  let stepIdx = 0;

  function nextStep() {
    if (stepIdx >= steps.length) {
      document.getElementById("wizard-status-title").innerText = "Mission roadmap compiled! Ready to strike.";
      document.getElementById("wizard-finished-footer").classList.remove("hide");
      return;
    }

    const current = steps[stepIdx];
    document.getElementById("wizard-status-title").innerText = current.label + "...";
    
    const el = document.getElementById(`decomp-step-${current.id}`);
    el.className = "decomp-step active-step";

    setTimeout(() => {
      el.className = "decomp-step completed";
      document.getElementById("wizard-progress-bar-fill").style.width = `${current.progress}%`;
      stepIdx++;
      nextStep();
    }, 1800);
  }

  nextStep();
}

// Launches fresh project tasks
document.getElementById("wizard-launch-swarm-btn").addEventListener("click", () => {
  const promptText = document.getElementById("wizard-app-prompt").value;
  const projectTitle = promptText.length > 30 ? promptText.substring(0, 27) + "..." : promptText;
  
  state.activeProject = projectTitle;
  document.getElementById("current-project-name").innerText = projectTitle;

  // Setup Fresh simulation state
  state.accumulatedCost = 0.05;
  state.llmRequests = 10;
  state.autoFixes = 0;
  state.testCoverage = 0;

  state.tasks = [
    {
      id: "fit-01",
      title: "Design Fitness API Specs",
      desc: "Architect the workout logs data structures, mapping GPS tracking matrices and coordinate arrays.",
      status: "in_progress",
      assignee: "architect",
      priority: 5,
      complexity: "complex",
      duration: "1 min elapsed",
      attempts: "1 / 3",
      tags: ["#architecture", "#api"],
      deps: [],
      progress: 20,
      output: ""
    },
    {
      id: "fit-02",
      title: "Setup Local Storage Cache",
      desc: "Implement IndexedDB hooks for offline storage support. Design workout sync sync queue handlers.",
      status: "backlog",
      assignee: "coder2",
      priority: 4,
      complexity: "medium",
      duration: "Prerequisite lock",
      attempts: "0 / 3",
      tags: ["#frontend", "#cache"],
      deps: ["fit-01"],
      output: ""
    },
    {
      id: "fit-03",
      title: "Write Route Calculation Tests",
      desc: "Author testing specs evaluating GPS distance logic models. Assert math calculations resolve correctly.",
      status: "backlog",
      assignee: "tester",
      priority: 4,
      complexity: "medium",
      duration: "Prerequisite lock",
      attempts: "0 / 3",
      tags: ["#testing", "#math"],
      deps: ["fit-01"],
      output: ""
    }
  ];

  // Set agents status
  Object.keys(state.agents).forEach(k => {
    state.agents[k].status = "idle";
    state.agents[k].currentTaskId = null;
    state.agents[k].cost = 0;
  });

  // Keep toggled status for autonomous agents
  const hunterToggleEl = document.getElementById("settings-hunter-toggle");
  state.agents.hunter.status = (hunterToggleEl && !hunterToggleEl.checked) ? "idle" : "watching";
  
  const updaterToggleEl = document.getElementById("settings-updater-toggle");
  state.agents.updater.status = (updaterToggleEl && !updaterToggleEl.checked) ? "sleeping" : "idle";

  state.agents.architect.status = "thinking";
  state.agents.architect.currentTaskId = "fit-01";

  // Re-write logs console
  const timestamp = new Date().toTimeString().split(" ")[0];
  consoleLogs = [
    { time: timestamp, agent: "system", type: "info", msg: `Initialized mission: ${projectTitle}.` },
    { time: timestamp, agent: "pm", type: "info", msg: "Stealth coordinates integrated. Strategy scrolls prepared." },
    { time: timestamp, agent: "orchestrator", type: "info", msg: "Shadow swarm unleashed. Scroll #fit-01 assigned to Grandmaster." }
  ];

  // Close modal
  document.getElementById("project-wizard-modal").classList.remove("active");

  // Re-render dashboard
  renderKanban();
  renderDecisions();
  renderLogs();
  selectAgent("architect");

  // Reset workbench state so it reloads tree files and previews of the new project!
  workbenchInitialized = false;

  // Switch to graph tab
  switchTab("swarm-graph");
});

// --- GLOBAL EVENT LISTENERS & NAVIGATION ---

function switchTab(tabId) {
  state.activeTab = tabId;

  // Toggle active tab content
  document.querySelectorAll(".tab-content").forEach(tab => {
    tab.classList.remove("active");
  });
  document.getElementById(`tab-${tabId}`).classList.add("active");

  // Toggle active menu button
  document.querySelectorAll(".nav-item").forEach(btn => {
    btn.classList.remove("active");
    if (btn.dataset.tab === tabId) btn.classList.add("active");
  });

  // Render and initialize tabs dynamically
  if (tabId === "mcp-registry") {
    renderMCPRegistry();
    initMCPRegistryForm();
  }

  if (tabId === "neural-graph") {
    setTimeout(() => {
      if (neuralGraphInstance) {
        const container = document.getElementById("neural-graph-canvas");
        if (container) {
          neuralGraphInstance.width(container.clientWidth);
          neuralGraphInstance.height(container.clientHeight);
          neuralGraphInstance.centerAt(0, 0);
        }
      } else {
        initNeuralGraph();
      }
    }, 150);
  }

  if (tabId === "sandbox-multiplexer") {
    initSandboxMultiplexer();
  }

  // Start / Stop graph animation loops
  if (tabId === "swarm-graph") {
    if (swarmGraph) {
      swarmGraph.resize();
      swarmGraph.start();
    }
  } else {
    if (swarmGraph) swarmGraph.stop();
  }

  // Initialize Monaco and file explorers if entering the Dojo Workbench
  if (tabId === "dojo-workbench") {
    initDojoWorkbench();
    if (editorInstance) {
      setTimeout(() => {
        editorInstance.layout();
      }, 100);
    }
  }

  // Initialize report rendering if entering Stealth Archives
  if (tabId === "mission-reports") {
    renderReport(state.activeReportId);
  }

  // Initialize sub-tabs rendering if entering Dojo Rules
  if (tabId === "settings") {
    renderSettingsSubtab(state.activeSettingsTab);
  }
}

function initNavigation() {
  document.querySelectorAll(".nav-item").forEach(btn => {
    btn.addEventListener("click", () => {
      switchTab(btn.dataset.tab);
    });
  });

  // Kanban filters
  document.querySelectorAll(".filter-pills .pill").forEach(pill => {
    pill.addEventListener("click", () => {
      document.querySelectorAll(".filter-pills .pill").forEach(p => p.classList.remove("active"));
      pill.classList.add("active");
      renderKanban(pill.dataset.filter);
    });
  });
}

function initGlobalControls() {
  // Global pauseBtn
  const pauseBtn = document.getElementById("global-pause-btn");
  pauseBtn.addEventListener("click", () => {
    const timestamp = new Date().toTimeString().split(" ")[0];
    if (state.systemStatus === "active") {
      state.systemStatus = "paused";
      pauseBtn.innerHTML = `
        <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 10 C2 10 4 5 12 5 C20 5 22 10 22 10 C22 10 20 15 12 15 C4 15 2 10 2 10 Z"/>
          <line x1="2" y1="10" x2="22" y2="10"/>
        </svg>
      `;
      pauseBtn.classList.remove("btn-outline");
      pauseBtn.classList.add("btn-purple");
      document.getElementById("system-status-indicator").className = "status-indicator-pulse offline";
      document.getElementById("system-status-text").innerText = "Swarm Hidden";

      consoleLogs.push({
        time: timestamp,
        agent: "orchestrator",
        type: "error",
        msg: "Stealth shroud activated. HALTING all active shinobi threads."
      });
    } else {
      state.systemStatus = "active";
      pauseBtn.innerHTML = `
        <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 10 C2 10 4 5 12 5 C20 5 22 10 22 10 C22 10 20 15 12 15 C4 15 2 10 2 10 Z"/>
          <line x1="2" y1="10" x2="22" y2="10"/>
          <circle cx="12" cy="10" r="2" fill="currentColor"/>
        </svg>
      `;
      pauseBtn.classList.add("btn-outline");
      pauseBtn.classList.remove("btn-purple");
      document.getElementById("system-status-indicator").className = "status-indicator-pulse online";
      document.getElementById("system-status-text").innerText = "Swarm Active";

      consoleLogs.push({
        time: timestamp,
        agent: "orchestrator",
        type: "success",
        msg: "Stealth shroud deactivated. Resuming active shinobi missions."
      });
    }
    renderLogs();
  });

  // Settings Sliders (legacy IDs — guarded for null safety)
  const dailySlider = document.getElementById("daily-limit-slider");
  const dailyVal = document.getElementById("daily-limit-val");
  if (dailySlider && dailyVal) {
    dailySlider.addEventListener("input", (e) => {
      state.dailyLimit = parseInt(e.target.value);
      dailyVal.innerText = `$${state.dailyLimit.toFixed(2)}`;
    });
  }

  const thresholdSlider = document.getElementById("alert-threshold-slider");
  const thresholdVal = document.getElementById("alert-threshold-val");
  if (thresholdSlider && thresholdVal) {
    thresholdSlider.addEventListener("input", (e) => {
      state.alertThreshold = parseInt(e.target.value) / 100;
      thresholdVal.innerText = `${e.target.value}%`;
    });
  }

  // Settings Autonomy radio selection (legacy — new name is autonomy-level-new)
  document.querySelectorAll("input[name='autonomy-level']").forEach(radio => {
    radio.addEventListener("change", (e) => {
      state.autonomyLevel = e.target.value;
      
      // Update css class
      document.querySelectorAll(".radio-option").forEach(opt => opt.classList.remove("active"));
      radio.closest(".radio-option").classList.add("active");

      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "system",
        type: "info",
        msg: `Stealth permit rules updated to: ${state.autonomyLevel.toUpperCase()}`
      });
      renderLogs();
    });
  });

  // Log Search and Filter inputs
  const searchInput = document.getElementById("log-search");
  searchInput.addEventListener("input", (e) => {
    state.logSearchQuery = e.target.value.trim();
    renderLogs();
  });

  const filterSelect = document.getElementById("log-filter-agent");
  filterSelect.addEventListener("change", (e) => {
    state.logFilterAgent = e.target.value;
    renderLogs();
  });

  // Console actions
  document.getElementById("console-clear-btn").addEventListener("click", () => {
    consoleLogs = [];
    renderLogs();
  });

  const toggleConsoleBtn = document.getElementById("console-toggle-btn");
  toggleConsoleBtn.addEventListener("click", () => {
    state.streamLogs = !state.streamLogs;
    if (state.streamLogs) {
      toggleConsoleBtn.innerHTML = `
        <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;vertical-align:middle;margin-right:4px;">
          <path d="M12 22 L12 4 M11 22 L9 5 M13 22 L15 5"/>
          <circle cx="12" cy="22" r="1.5" fill="currentColor"/>
        </svg>
        <span>Pause Scroll</span>
      `;
      toggleConsoleBtn.className = "btn btn-purple btn-sm";
    } else {
      toggleConsoleBtn.innerHTML = `
        <svg class="jp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;vertical-align:middle;margin-right:4px;">
          <path d="M12 21 L3 12 C3 12 6 7 12 7 C18 7 21 12 21 12 Z"/>
          <path d="M12 21 L7 10 M12 21 L12 7 M12 21 L17 10"/>
        </svg>
        <span>Resume Scroll</span>
      `;
      toggleConsoleBtn.className = "btn btn-outline btn-sm";
    }
  });

  // Always-On Engine Toggle listeners
  const hunterToggle = document.getElementById("settings-hunter-toggle");
  if (hunterToggle) {
    hunterToggle.addEventListener("change", (e) => {
      const active = e.target.checked;
      state.agents.hunter.status = active ? "watching" : "idle";
      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "hunter",
        type: active ? "success" : "error",
        msg: `Stealth Scout: Autonomous telemetry hunting ${active ? 'ENABLED' : 'DISABLED'}.`
      });
      renderLogs();
    });
  }

  const updaterToggle = document.getElementById("settings-updater-toggle");
  if (updaterToggle) {
    updaterToggle.addEventListener("change", (e) => {
      const active = e.target.checked;
      state.agents.updater.status = active ? "idle" : "sleeping";
      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "updater",
        type: active ? "success" : "error",
        msg: `Debt Chunin: Cron sweep updates scheduler ${active ? 'ENABLED' : 'DISABLED'}.`
      });
      renderLogs();
    });
  }

  const refactorToggle = document.getElementById("settings-refactor-toggle");
  if (refactorToggle) {
    refactorToggle.addEventListener("change", (e) => {
      const active = e.target.checked;
      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "orchestrator",
        type: active ? "success" : "info",
        msg: `Sensei: Background refactoring idle sweeps ${active ? 'ENABLED' : 'DISABLED'}.`
      });
      renderLogs();
    });
  }

  const sentryInput = document.getElementById("settings-sentry-url");
  if (sentryInput) {
    sentryInput.addEventListener("change", (e) => {
      const val = e.target.value.trim();
      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "hunter",
        type: "info",
        msg: `Stealth Scout: Sentry target coordinates updated to ${val}`
      });
      renderLogs();
    });
  }

  const datadogInput = document.getElementById("settings-datadog-key");
  if (datadogInput) {
    datadogInput.addEventListener("change", (e) => {
      const timestamp = new Date().toTimeString().split(" ")[0];
      consoleLogs.push({
        time: timestamp,
        agent: "hunter",
        type: "info",
        msg: "Stealth Scout: Datadog authentication keys re-scrambled."
      });
      renderLogs();
    });
  }
}

