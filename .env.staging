# Staging Environment Configuration
# This file is used when running `npm run build:staging`

# App Configuration
VITE_APP_NAME=CodeWeaver Dashboard (Staging)
VITE_BASE_PATH=/
VITE_PORT=3000
VITE_HOST=0.0.0.0
VITE_OPEN_BROWSER=false

# Build Configuration
VITE_SOURCEMAP=true
VITE_MINIFY=true

# API Configuration
VITE_API_BASE_URL=https://staging-api.codeweaver.com/api
VITE_WS_BASE_URL=wss://staging-api.codeweaver.com
VITE_WS_URL=wss://staging-api.codeweaver.com/v1/sync

# Sentry & Analytics Monitoring
VITE_SENTRY_DSN=https://sentry_dsn_staging@sentry.io/123456
VITE_ANALYTICS_KEY=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true
VITE_ENABLE_MOCKS=false

# Debug
VITE_DEBUG=true
VITE_ENV_META=<meta name="environment" content="staging" />

# Sitemap
VITE_SITEMAP_URL=https://staging.codeweaver.com/sitemap.xml
