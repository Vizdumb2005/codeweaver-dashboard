# Development Environment Configuration
# This file is used when running `npm run dev`

# App Configuration
VITE_APP_NAME=CodeWeaver Dashboard (Dev)
VITE_BASE_PATH=/
VITE_PORT=3000
VITE_HOST=localhost
VITE_OPEN_BROWSER=true

# Build Configuration
VITE_SOURCEMAP=true
VITE_MINIFY=false

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true
VITE_ENABLE_MOCKS=true

# Debug
VITE_DEBUG=true
VITE_ENV_META=
